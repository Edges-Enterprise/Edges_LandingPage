# ==============================================================================
# .env.example — Edges Network / Edges_LandingPage
#
# Generated from the full environment-variable inventory in architecture.md's
# "Environment variables inventory" section (55 distinct vars, grepped from
# every process.env.* reference in src/). This file has never existed before
# in this repo — see handover.md Step 0.2.
#
# Copy this to .env.local and fill in real values. Never commit .env.local.
#
# NOTE on APP2_/APP3_ SUPABASE vars below: their purpose is NOT documented
# anywhere in code comments as of this writing. They may be a staging/multi-
# environment setup (architecture.md speculates this) — confirm with the
# product owner before assuming they're dead config.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is a privileged key that bypasses Row Level
# Security. Never prefix this with NEXT_PUBLIC_ — doing so inlines it into
# the client-side bundle (this was a real bug in this codebase, fixed
# 2026-09-06; see architecture.md Known Irregularity #5). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_DELETE_ACCOUNT_FUNCTION_URL=

# Secondary Supabase projects/apps — purpose unconfirmed, see note above.
APP2_SUPABASE_URL=
APP2_SUPABASE_SECRET_KEY=
APP3_SUPABASE_URL=
APP3_SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Payments
# ------------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

KORAPAY_SECRET_KEY=

XIXAPAY_API_KEY=
XIXAPAY_SECRET_KEY=
XIXAPAY_BUSINESS_ID=
NEXT_PUBLIC_XIXAPAY_API_KEY=
NEXT_PUBLIC_XIXAPAY_SECRET_KEY=
NEXT_PUBLIC_XIXAPAY_BUSINESS_ID=

NEXT_PUBLIC_PAYVESSEL_API_KEY=
NEXT_PUBLIC_PAYVESSEL_SECRET_KEY=
NEXT_PUBLIC_PAYVESSEL_BUSINESS_ID=

# ------------------------------------------------------------------------------
# VTU / data upstream providers
# ------------------------------------------------------------------------------
ZENDIT_API_KEY=
ZENDIT_BASE_URL=
ZENDIT_SECRET_KEY=

ACCRAGH_API_KEY=
ACCRAGH_BASE_URL=
ACCRAGH_SECRET_KEY=

LIZZYSUB_API_KEY=
LIZZYSUB_BASE_URL=
LIZZYSUB_SECRET_KEY=

# ------------------------------------------------------------------------------
# Firebase (push notifications)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=

# ------------------------------------------------------------------------------
# GitHub build pipeline (Layer 2 reference; Layer 3's own publishing pipeline
# will need the equivalent of these once built — see handover.md Task 3b)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ------------------------------------------------------------------------------
# App / misc
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_STORE_URL=
API_SECRET_KEY=
NODE_ENV=development
